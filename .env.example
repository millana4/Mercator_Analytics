# ---------- Приложение ----------
APP_ENV=local
LOG_LEVEL=INFO

# Ключ межсервисной авторизации
SERVICE_API_KEY=string

# ---------- Источник данных: mock | real ----------
CONNECTOR_KIND=mock
MOCK_DATA_DIR=/data/backups
DEBUG_CHARTS = True

# ---------- Своя база (результаты аналитики) ----------
ANALYTICS_PG_HOST=an-postgres
ANALYTICS_PG_PORT=5432
ANALYTICS_PG_DB=analytics
ANALYTICS_PG_USER=analytics
ANALYTICS_PG_PASSWORD=change_me
# на какой адрес хоста публиковать порт БД (loopback, наружу не выставлять)
ANALYTICS_PG_BIND=127.0.0.1:5434

# ---------- Postgres ядра (только чтение) ----------
CORE_PG_HOST=tm-postgres
CORE_PG_PORT=5432
CORE_PG_DB=taskmanager
CORE_PG_USER=taskmanager
CORE_PG_PASSWORD=change_me

# ---------- ClickHouse ядра (только чтение) ----------
CORE_CH_HOST=tm-clickhouse
CORE_CH_PORT=8123
CORE_CH_DB=taskmanager
CORE_CH_USER=default
CORE_CH_PASSWORD=change_me

# ---------- Сеть docker ядра (внешняя, уже существует) ----------
CORE_NETWORK=taskmanager_default

SCHEDULER_ENABLED=true

JWT_SECRET_KEY=string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://server_ip